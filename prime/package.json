    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.52.0",
    "mysql2": "^3.24.5",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
